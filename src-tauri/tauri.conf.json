{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rega Notes",
  "version": "0.1.1",
  "identifier": "com.rega.notes",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Rega Notes",
        "width": 420,
        "height": 640,
        "minWidth": 420,
        "maxWidth": 420,
        "minHeight": 280,
        "maxHeight": 760,
        "transparent": true,
        "alwaysOnTop": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["reganotes"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
